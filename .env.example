# AIForge Environment Configuration

# Environment mode: development | staging | production | testing
ENVIRONMENT=development
PROJECT_NAME="AIForge Multimodal Platform"
DEBUG=true
LOG_LEVEL=INFO

# Application Server
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=aiforge-insecure-development-secret-key-change-in-production-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL / SQLite fallback for lightweight development/testing)
DATABASE_URL=postgresql+asyncpg://aiforge_user:aiforge_password@localhost:5432/aiforge_db
# In-memory/local SQLite fallback example:
# DATABASE_URL=sqlite+aiosqlite:///./aiforge.db

# Redis Cache & Broker
REDIS_URL=redis://localhost:6379/0

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# Storage & Artifacts Path
ARTIFACT_STORAGE_PATH=./storage/artifacts
DATASET_STORAGE_PATH=./storage/datasets

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
